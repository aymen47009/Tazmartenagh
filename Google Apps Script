// دالة اختبار (تشغيل من وحدة التحرير)
function testDeployment() {
  Logger.log("🧪 بدء الاختبار...");
  
  const testPayload = {
    type: "inventory_add",
    timestamp: new Date().toLocaleString("ar-SA"),
    data: {
      id: "test123",
      name: "عتاد اختبار",
      totalQty: 10
    }
  };
  
  Logger.log("البيانات المرسلة: " + JSON.stringify(testPayload));
  
  // محاكاة الطلب
  const e = {
    postData: {
      contents: JSON.stringify(testPayload)
    }
  };
  
  const result = doPost(e);
  Logger.log("✅ نتيجة الاختبار:");
  Logger.log(result.getContent());
}

// دالة الحصول على البيانات الحالية
function getSheetData() {
  try {
    const spreadsheet = SpreadsheetApp.openById(SPREADSHEET_ID);
    const sheet = spreadsheet.getSheets()[0];
    
    const data = sheet.getDataRange().getValues();
    Logger.log(`عدد الصفوف: ${data.length}`);
    
    if (data.length > 0) {
      Logger.log("آخر 5 صفوف:");
      for (let i = Math.max(0, data.length - 5); i < data.length; i++) {
        Logger.log(data[i].join(" | "));
      }
    }
    
    return data;
  } catch (error) {
    Logger.log(`❌ خطأ في جلب البيانات: ${error.message}`);
  }
}

// دالة معلومات الجدول
function getSpreadsheetInfo() {
  try {
    const spreadsheet = SpreadsheetApp.openById(SPREADSHEET_ID);
    const sheets = spreadsheet.getSheets();
    
    Logger.log("معلومات الجدول:");
    Logger.log("عدد الـ Sheets: " + sheets.length);
    
    for (let i = 0; i < sheets.length; i++) {
      const sheet = sheets[i];
      Logger.log(`${i + 1}. ${sheet.getName()} - صفوف: ${sheet.getLastRow()}`);
    }
  } catch (error) {
    Logger.log(`❌ خطأ: ${error.message}`);
  }
}